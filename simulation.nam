V -t * -v 1.0a5 -a 0
W -t * -x 800 -y 400
n -t * -s 0 -S DORMANT -c blue -i blue -a 0 -o 0.0.0.0 -v circle -l "Customer(n0)"
n -t * -s 1 -S DORMANT -c red -i red -a 1 -o 1.0.0.0 -v circle -l "Attacker(n1)"
n -t * -s 2 -S DORMANT -c cyan -i cyan -a 2 -o 2.0.0.0 -v box -l "EdgeSwitch(n2)"
n -t * -s 3 -S DORMANT -c cyan -i cyan -a 3 -o 3.0.0.0 -v box -l "CoreSwitch(n3)"
n -t * -s 4 -S DORMANT -c green -i green -a 4 -o 4.0.0.0 -v hexagon -l "BankServer(n4)"
n -t * -s 5 -S DORMANT -c purple -i purple -a 5 -o 5.0.0.0 -v hexagon -l "Honeypot(n5)"
l -t * -s 0 -d 2 -S UP -r 10Mb -D 5ms -c black
l -t * -s 1 -d 2 -S UP -r 10Mb -D 5ms -c black
l -t * -s 2 -d 3 -S UP -r 2Mb -D 10ms -c black
l -t * -s 3 -d 4 -S UP -r 10Mb -D 5ms -c black
l -t * -s 2 -d 5 -S UP -r 10Mb -D 5ms -c black
